<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Charter.Agent</RootNamespace>
    <AssemblyName>charter-agent</AssemblyName>
  </PropertyGroup>

  <!--
    Section 33.7: a single static binary per platform (linux/amd64, linux/arm64, darwin/arm64,
    windows/amd64), published to GitHub Releases, plus a container image for Docker mode.
    Installation is one command; that is the adoption bar for a companion daemon.

      dotnet publish src/Charter.Agent -c Release -r linux-x64

    These only apply once a RID is chosen, so a plain `dotnet build` of the solution stays portable.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>

    <!--
      EnableCompressionInSingleFile is deliberately OFF.

      With it on (.NET 10.0.302, osx-arm64) the published binary dies with an
      AccessViolationException inside Interop.Sys.Fcntl.GetIsNonBlocking the first time it starts a
      child process with redirected output - which is the very first thing the daemon does, since
      capabilities are probed by running dotnet/node/xcodebuild (section 32.2). The compressed
      bundle mis-resolves the bundled native libraries; the same source published without
      compression probes correctly. A binary that is 44MB smaller and crashes on startup is not a
      trade worth making, and the failure mode is far enough from its cause to cost an operator a
      long evening.
    -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup>
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-arm64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
