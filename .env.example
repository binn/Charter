# Charter configuration
#
# Copy this file to .env and fill in the required values:
#
#     cp .env.example .env
#
# Every setting is a flat environment variable. There is no appsettings.json and no
# Section__Nested__Key convention. Charter validates all of this once at startup and,
# if anything is wrong, prints every problem at once and exits non-zero.
#
# Required variables are uncommented below with obviously-fake placeholder values.
# Optional variables are commented out and show their default.
#
# Never commit a filled-in .env. It is gitignored for a reason.
# Full reference: docs/configuration.md


# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection, as a URL. Both postgres:// and postgresql:// are accepted.
# This is not an EF Core connection string; Charter converts it.
# The value below matches the bundled docker-compose.yml.
DATABASE_URL=postgres://charter:charter@postgres:5432/charter

# Running Postgres in a container and Charter on your host instead:
# DATABASE_URL=postgres://charter:charter@localhost:5432/charter
#
# Managed Postgres usually needs TLS. Supported sslmode values: disable, require,
# verify-full. require is the default when the parameter is absent.
# DATABASE_URL=postgres://user:password@db.example.com:5432/charter?sslmode=require
#
# On Railway, use DATABASE_URL (the private network address). Do not use
# DATABASE_PUBLIC_URL for the app.

# Public URL of this instance. Used for GitHub webhook callbacks, OAuth redirects,
# and every link Charter sends anyone. It must be reachable from GitHub.
CHARTER_BASE_URL=https://charter.example.com

# HTTP port. PaaS platforms set this for you.
# PORT=8080

# personal | organization
# personal is not a separate code path: it is one organization with one member
# holding every role and approval gates auto-satisfied. Inviting a second person
# is the only thing that changes, and it needs no migration.
# CHARTER_MODE=personal


# ─────────────────────────────────────────────────────────────────────────────
# Key material
# ─────────────────────────────────────────────────────────────────────────────
#
# Generate each key with:
#
#     openssl rand -base64 32
#
# Run it twice. THE TWO KEYS MUST BE DIFFERENT. CHARTER_SECRET_KEY signs cookies
# and tokens; CHARTER_CREDENTIAL_KEY encrypts stored model credentials at rest.
# They are separate so that rotating the cookie key does not invalidate every
# credential every user has linked. Reusing one value for both throws that away.
#
# Both need at least 32 bytes of decoded entropy, not 32 characters. Validation
# base64-decodes the value when it parses as base64 and measures the decoded length,
# so the 44-character output of the command above is correct. Startup fails if
# either is too short, or if the two are identical.

CHARTER_SECRET_KEY=REPLACE-THIS-WITH-openssl-rand-base64-32-out
CHARTER_CREDENTIAL_KEY=REPLACE-THIS-WITH-A-DIFFERENT-openssl-rand-32


# ─────────────────────────────────────────────────────────────────────────────
# GitHub App
# ─────────────────────────────────────────────────────────────────────────────
#
# Charter talks to GitHub as a GitHub App, never as a user. Create one at
# https://github.com/settings/apps and install it on the org that owns your repos.

GITHUB_APP_ID=123456

# The App's private key, PEM. Base64 is accepted and is easier to put in a single
# environment variable. Produce the base64 form with:
#
#     base64 < charter.private-key.pem | tr -d '\n'
#
GITHUB_APP_PRIVATE_KEY=REPLACE-WITH-BASE64-OF-YOUR-GITHUB-APP-PEM

# Shared secret for webhook signature verification. Set the same value in the
# App's webhook settings. Generate one with:
#
#     openssl rand -hex 32
#
GITHUB_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32-output


# ─────────────────────────────────────────────────────────────────────────────
# Model credentials
# ─────────────────────────────────────────────────────────────────────────────
#
# At least one model credential must resolve at startup: either an instance-level
# key here, or a credential a user has linked in the app. Startup fails if neither
# exists. Keys set here are the instance-level fallback, used when a requester has
# no credential of their own.

ANTHROPIC_API_KEY=sk-ant-api03-REPLACE-WITH-YOUR-ANTHROPIC-KEY

# OpenRouter, if you want provider freedom for control-plane calls (refinement,
# teaching, recap, recon). Note that agent runs are limited to what the agent CLI
# itself supports, which is narrower.
# OPENROUTER_API_KEY=sk-or-v1-replace-with-your-openrouter-key

# Let users opt their personal subscription credentials into an org-wide shared
# pool, so one person's quota can serve another person's request. Off by default,
# deliberately: consumer subscription terms may prohibit it. Read docs/credentials.md
# and check your provider's terms before enabling this.
# CHARTER_ALLOW_SHARED_POOL=false


# ─────────────────────────────────────────────────────────────────────────────
# Models
# ─────────────────────────────────────────────────────────────────────────────
#
# Model identifiers may be provider-qualified, for example anthropic/claude-opus-5
# or openrouter/deepseek/deepseek-r1. Per-repo and per-task overrides live in the
# repository's .charter/config.yml and take precedence over these.

# Spec refinement. Runs often and benefits from being cheap.
# CHARTER_MODEL_REFINE=claude-sonnet-5

# The build. Passed through to the agent CLI, so it must be a model that CLI supports.
# CHARTER_MODEL_BUILD=claude-opus-5

# Walkthroughs, inline annotations, and explain-this.
# CHARTER_MODEL_TEACH=claude-sonnet-5


# ─────────────────────────────────────────────────────────────────────────────
# Runner
# ─────────────────────────────────────────────────────────────────────────────
#
# Where agent sessions actually execute.
#
#   github-actions  Zero-infrastructure default. Works on any PaaS, including
#                   platforms that block Docker access. Slowest: fresh VM per run.
#   docker          Spawns sibling containers through the local Docker socket.
#                   This is root-equivalent access to the host. Compose self-hosts only.
#
#   agent           The Charter Agent: an outbound-connecting daemon on your own
#                   hardware. Required for macOS, Xcode, licensed toolchains, and
#                   anything hardware-attached, and the fastest backend, because
#                   toolchains and caches persist. Arrives in Phase 2.
#
# Comma-separate to enable several; the dispatcher routes each session to a runner
# whose advertised capabilities match. See docs/runners.md.
# CHARTER_RUNNER=github-actions


# ─────────────────────────────────────────────────────────────────────────────
# Object storage
# ─────────────────────────────────────────────────────────────────────────────
#
# S3-compatible storage for verification artifacts and offloaded transcripts.
# MinIO, Cloudflare R2, Backblaze B2, and Wasabi all work.
#
# Optional only until something needs it. Charter starts without it, but any
# project type producing a downloadable build, a screen capture, or a
# hardware-in-the-loop report requires it, and so does running on a PaaS with no
# durable local disk. An IPA is not a database row.
#
# Setting the endpoint makes the bucket and both keys required; they are validated
# together. Left unset, Charter keeps artifacts in Postgres and refuses to onboard
# a repo whose project type needs artifact storage, naming these variables when it does.

# CHARTER_STORAGE_ENDPOINT=https://s3.example.com
# CHARTER_STORAGE_BUCKET=charter-artifacts
# CHARTER_STORAGE_ACCESS_KEY=replace-with-your-access-key
# CHARTER_STORAGE_SECRET_KEY=replace-with-your-secret-key

# Some providers require a real region rather than auto.
# CHARTER_STORAGE_REGION=auto

# MinIO and most self-hosted gateways need path-style addressing.
# CHARTER_STORAGE_FORCE_PATH_STYLE=true


# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────

# verbose | debug | information | warning | error | fatal
# CHARTER_LOG_LEVEL=information

# Console sink formatting. The console sink always exists, so its shape has to suit
# wherever Charter runs. An invalid value fails startup rather than falling back.
#
#   DEFAULT       Human-readable, coloured when the terminal supports it.
#                 Local development and docker compose up.
#   JSON          One compact JSON object per line. For anything that scrapes stdout
#                 and parses JSON: Loki, Vector, Fluent Bit, CloudWatch.
#   RAILWAY_JSON  One JSON object per line shaped for Railway's structured log
#                 parser, so fields render as filterable attributes.
# LOGGING_MODE=DEFAULT

# Seq is the primary structured log target and the first place to look when
# debugging a session. Setting the URL enables the sink.
# CHARTER_SEQ_URL=http://seq:5341
# CHARTER_SEQ_API_KEY=replace-with-your-seq-api-key

# Include full agent transcript bodies in log events.
#
# WARNING: transcripts contain your source code and your business context. Turning
# this on exports both into whatever log platform you are shipping to. Charter logs
# event metadata (type, timing, file paths, cost) by default for exactly this reason.
# CHARTER_LOG_INCLUDE_TRANSCRIPTS=false


# ─────────────────────────────────────────────────────────────────────────────
# OpenTelemetry
# ─────────────────────────────────────────────────────────────────────────────
#
# Standard OTEL_* names are honoured as-is, so an existing collector configuration
# works unchanged. Setting the endpoint enables OTLP export of logs, traces, and
# metrics together. Seq and OTLP are complementary; running both is normal.

# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=replace-with-your-collector-key
# OTEL_SERVICE_NAME=charter


# ─────────────────────────────────────────────────────────────────────────────
# Authentication providers
# ─────────────────────────────────────────────────────────────────────────────
#
# Email and password sign-in is always available. Each OAuth provider below is
# enabled only when both its ID and its secret are set.
#
# Slack and Discord pull double duty: linking those identities is what makes
# inbound requests from those platforms work.

# CHARTER_OAUTH_GITHUB_ID=Iv1.replace-with-your-github-oauth-id
# CHARTER_OAUTH_GITHUB_SECRET=replace-with-your-github-oauth-secret

# CHARTER_OAUTH_GOOGLE_ID=000000000000-replaceme.apps.googleusercontent.com
# CHARTER_OAUTH_GOOGLE_SECRET=replace-with-your-google-oauth-secret

# CHARTER_OAUTH_DISCORD_ID=000000000000000000
# CHARTER_OAUTH_DISCORD_SECRET=replace-with-your-discord-oauth-secret

# CHARTER_OAUTH_SLACK_ID=0000000000.0000000000000
# CHARTER_OAUTH_SLACK_SECRET=replace-with-your-slack-oauth-secret

# SAML single sign-on. Organization mode only.
# CHARTER_SAML_METADATA_URL=https://idp.example.com/app/charter/sso/saml/metadata


# ─────────────────────────────────────────────────────────────────────────────
# Notifications
# ─────────────────────────────────────────────────────────────────────────────

# Outbound email. Without it, Charter falls back to in-app notifications only.
# Percent-encode any special characters in the username or password. An email
# address used as a username needs its @ written as %40.
# CHARTER_SMTP_URL=smtp://charter%40example.com:replace-with-smtp-password@smtp.example.com:587


# ─────────────────────────────────────────────────────────────────────────────
# Budgets
# ─────────────────────────────────────────────────────────────────────────────
#
# Starting points only. Per-org, per-team, per-repo, and per-user budgets are
# configured in the app and override these.

# Ceiling for a single session. Sessions refuse to start rather than dying halfway.
# CHARTER_DEFAULT_SESSION_BUDGET_USD=5.00

# Per-person monthly ceiling. In small teams this, not approval, is the real governor.
# CHARTER_DEFAULT_MONTHLY_BUDGET_USD=100.00


# ─────────────────────────────────────────────────────────────────────────────
# Update check
# ─────────────────────────────────────────────────────────────────────────────
#
# Charter reads the GitHub Releases API once a day to see whether a newer version
# exists. This is the only outbound request Charter makes on its own initiative.
# It sends nothing about your instance: it is an unauthenticated read of a public
# endpoint, and GitHub sees the source IP as it would for any HTTP request.
# Failures degrade silently, so an air-gapped instance does not log an error a day.
#
# The default is on, because an operator silently running a version with a known
# vulnerability is a far worse outcome. See docs/privacy.md.
# CHARTER_UPDATE_CHECK=true

# stable | prerelease
# CHARTER_UPDATE_CHANNEL=stable


# ─────────────────────────────────────────────────────────────────────────────
# Feature gates
# ─────────────────────────────────────────────────────────────────────────────

# Allow Charter to create new repositories from your org's templates.
#
# This is a privilege escalation and is off by default. It also requires org-level
# repository creation scope on the GitHub App and a role that carries the capability.
# All three gates must be open. Prefer creating into a sandbox org; see docs/standards.md.
# CHARTER_ALLOW_REPO_CREATION=false

# Demo mode: seed a fake organisation, repo, and completed sessions with realistic
# transcripts and artifacts, and disable all outbound calls. Lets someone evaluate
# Charter without connecting a GitHub App or spending a token.
#
# Never enable this on an instance holding real data.
# CHARTER_DEMO=false
